# Your Google Gemini API key (free at https://aistudio.google.com)
GOOGLE_API_KEY=your-gemini-api-key-here

# Postgres connection (used by MCP server)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=helpdesk
POSTGRES_USER=jagritpandit
POSTGRES_PASSWORD=

# ChromaDB persist directory
CHROMA_PERSIST_DIR=./chroma_db

# Agent model (Gemini)
AGENT_MODEL=gemini-2.5-flash

# Embedding model
EMBEDDING_MODEL=models/gemini-embedding-001

# API server
API_HOST=0.0.0.0
API_PORT=8000
